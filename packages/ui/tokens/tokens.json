{
  "$description": "GoMenu design tokens. PLACEHOLDER VALUES until the Claude Design export arrives: replace values here (keep the names), then run `pnpm tokens`. Components only ever reference these names.",
  "color": {
    "background":           { "light": "#ffffff", "dark": "#0e1013" },
    "foreground":           { "light": "#14161a", "dark": "#eef0f3" },
    "muted":                { "light": "#f3f4f6", "dark": "#1a1d22" },
    "muted-foreground":     { "light": "#5b6170", "dark": "#a3a9b6" },
    "card":                 { "light": "#ffffff", "dark": "#15181c" },
    "card-foreground":      { "light": "#14161a", "dark": "#eef0f3" },
    "border":               { "light": "#e3e5ea", "dark": "#2a2e35" },
    "input":                { "light": "#d4d7de", "dark": "#353a42" },
    "ring":                 { "light": "#2f5bea", "dark": "#7d9bff" },
    "primary":              { "light": "#1f2937", "dark": "#e5e7eb" },
    "primary-foreground":   { "light": "#ffffff", "dark": "#111318" },
    "secondary":            { "light": "#eef0f3", "dark": "#23272e" },
    "secondary-foreground": { "light": "#14161a", "dark": "#eef0f3" },
    "accent":               { "light": "#2f5bea", "dark": "#7d9bff" },
    "accent-foreground":    { "light": "#ffffff", "dark": "#0e1013" },
    "destructive":          { "light": "#c62828", "dark": "#ff6b6b" },
    "destructive-foreground": { "light": "#ffffff", "dark": "#1a0b0b" },
    "success":              { "light": "#1b7f4b", "dark": "#4ade80" },
    "success-foreground":   { "light": "#ffffff", "dark": "#06210f" },
    "warning":              { "light": "#a15c00", "dark": "#fbbf24" },
    "warning-foreground":   { "light": "#ffffff", "dark": "#231500" }
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "full": "9999px"
  },
  "font": {
    "sans": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "arabic": "'Noto Sans Arabic', 'Geeza Pro', 'Segoe UI', Tahoma, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "shadow": {
    "sm": "0 1px 2px rgb(0 0 0 / 0.06)",
    "md": "0 4px 16px rgb(0 0 0 / 0.08)"
  }
}
