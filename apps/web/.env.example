# Names only. Copy to apps/web/.env.local and fill in. Never commit real values.
# Local values are printed by `pnpm db:start` (`supabase status`).

# Public (exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=

# Server-only secrets (Vercel: mark as Sensitive; never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts parked staff sessions on
# shared devices (PIN lock). Rotating it signs out everyone parked behind a PIN.
GOMENU_SESSION_KEY=

# AI menu import and translation (Claude). GOMENU_AI_PROVIDER=fake uses a deterministic
# stand-in (tests/dev); when unset, Claude is used if ANTHROPIC_API_KEY is set.
GOMENU_AI_PROVIDER=
ANTHROPIC_API_KEY=

# Custom domains (Vercel Domains API). Without a token a stand-in marks domains active.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional: extra comma-separated hostnames that serve the GoMenu app itself (e.g. gomenu.om,
# www.gomenu.om). Any other host is treated as a restaurant's custom domain.
GOMENU_APP_HOSTS=
# Vercel Cron sends this as a Bearer token to /api/cron/domains.
CRON_SECRET=

# Development only: enables /dev/outbox (OTP codes and invitation links). Leave unset/false
# in staging and production.
GOMENU_DEV_OUTBOX=

# Tests only (defaults target the local Supabase stack)
SUPABASE_DB_URL=
PW_CHROMIUM_PATH=
